<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <calmfox_admin_invitation>
            <invitation>
                <ttl_days>3</ttl_days>
            </invitation>
            <password>
                <min_length>12</min_length>
                <min_strength>3</min_strength>
                <not_compromised>0</not_compromised>
                <generated_length>20</generated_length>
                <apply_everywhere>1</apply_everywhere>
            </password>
            <emails>
                <identity>general</identity>
                <invitation_template>calmfox_admin_invitation_emails_invitation_template</invitation_template>
                <password_reset_template>calmfox_admin_invitation_emails_password_reset_template</password_reset_template>
            </emails>
        </calmfox_admin_invitation>
    </default>
</config>
