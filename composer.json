{
    "name": "calmfox/magento-admin-invitation-module",
    "description": "Invite Magento administrators by e-mail: type an address, the invitee sets their own name and a strong password.",
    "type": "magento2-module",
    "keywords": [
        "magento",
        "magento2",
        "magento2-module",
        "admin",
        "invitation",
        "password-policy"
    ],
    "license": "MIT",
    "homepage": "https://github.com/calmfoxpl/magento-admin-invitation-module",
    "authors": [
        {
            "name": "Calmfox",
            "homepage": "https://calmfox.pl"
        }
    ],
    "support": {
        "issues": "https://github.com/calmfoxpl/magento-admin-invitation-module/issues",
        "source": "https://github.com/calmfoxpl/magento-admin-invitation-module",
        "security": "https://github.com/calmfoxpl/magento-admin-invitation-module/security/advisories/new"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "magento/framework": "^103.0",
        "magento/module-authorization": "^100.4",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-email": "^101.1",
        "magento/module-store": "^101.1",
        "magento/module-user": "^101.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Calmfox\\AdminInvitation\\": ""
        },
        "exclude-from-classmap": [
            "tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Calmfox\\AdminInvitation\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
